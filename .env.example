# Copy to .env and fill in. .env is gitignored.
DISCORD_TOKEN=

# Optional: your server id -> slash commands appear instantly instead of ~1h global propagation
GUILD_ID=

# Optional: max tracks held in the queue
MAX_QUEUE=500

# Optional: path to a Netscape cookies.txt exported from a logged-in browser.
# Only needed if yt-dlp starts returning "Sign in to confirm you're not a bot".
YTDLP_COOKIES=

# Optional: also accept "!play ..." typed in chat. Requires turning ON
# "Message Content Intent" in the dev portal first, otherwise the bot won't log in.
ENABLE_PREFIX_COMMANDS=
# Playback volume 0..1 (consoles report 1.0 as deafening)
VOLUME=0.2

# Optional: seconds with nothing playing before the bot leaves the voice channel (0 = never)
IDLE_TIMEOUT=300
